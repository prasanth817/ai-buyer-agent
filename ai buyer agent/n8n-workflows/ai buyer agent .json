      "name": "user details parser"
    },
    {
      "parameters": {
        "jsCode": "// Get merged data from Combine mode\nconst mergedData = $input.first().json;\n\n// The merged data should have both intent and products\n// Extract them based on the actual structure\n\n// Try to find intent (from Gemini parse node)\nconst intent = mergedData.product || mergedData.max_price ? mergedData : mergedData;\n\n// Try to find products (from HTTP Request node)\nconst products = mergedData.id ? [mergedData] : \n                 (Array.isArray(mergedData) ? mergedData : \n                 [\n                   {\"id\":\"prod_001\",\"name\":\"Wireless Charger\",\"price\":1499,\"currency\":\"INR\",\"available\":true},\n                   {\"id\":\"prod_002\",\"name\":\"USB-C Cable\",\"price\":299,\"currency\":\"INR\",\"available\":true},\n                   {\"id\":\"prod_003\",\"name\":\"Power Bank 10000mAh\",\"price\":1999,\"currency\":\"INR\",\"available\":true}\n                 ]);\n\n// If products is the merged object itself, use hardcoded\nconst productsToUse = Array.isArray(products) && products.length > 3 ? products : [\n  {\"id\":\"prod_001\",\"name\":\"Wireless Charger\",\"price\":1499,\"currency\":\"INR\",\"available\":true,\"description\":\"15W fast wireless charger\"},\n  {\"id\":\"prod_002\",\"name\":\"USB-C Cable\",\"price\":299,\"currency\":\"INR\",\"available\":true,\"description\":\"1m braided USB-C cable\"},\n  {\"id\":\"prod_003\",\"name\":\"Power Bank 10000mAh\",\"price\":1999,\"currency\":\"INR\",\"available\":true,\"description\":\"Fast charging power bank\"}\n];\n\n// Find matching product\nconst match = productsToUse.find(p => \n  p.name.toLowerCase().includes(intent.product.toLowerCase()) && \n  p.price <= intent.max_price\n);\n\nif (!match) {\n  throw new Error(`No matching product found for: ${intent.product} with max price: ${intent.max_price}`);\n}\n\nreturn {\n  product: match,\n  cart: {\n    items: [{product_id: match.id, qty: 1}],\n    shipping: intent.shipping || \"standard\"\n  }\n};"
      },
