      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json.content.parts[0].text;\nconst intent = JSON.parse(geminiResponse);\n\n// Set default shipping if null\nif (!intent.shipping) {\n  intent.shipping = \"standard\";\n}\n\nreturn intent;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1552,
        192
      ],
